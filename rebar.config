{minimum_otp_vsn, "R21.3"}.
{erl_opts, [
    debug_info,
    {parse_transform, lager_transform}
]}.

{deps, [
    lager,
    jsx,
    {pgsql,
        {git, "https://github.com/semiocast/pgsql.git", {branch, "master"}}},
    episcina
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [pgdb]}
]}.
